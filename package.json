{
  "name": "opensend",
  "private": true,
  "description": "OpenSend – developer-focused transactional email platform (working name).",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel --filter=@opensend/api --filter=@opensend/worker --filter=@opensend/web",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=1",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @opensend/db generate",
    "db:migrate": "pnpm --filter @opensend/db migrate",
    "setup:local": "node scripts/setup-local.mjs",
    "bootstrap:token": "pnpm --filter @opensend/api cli bootstrap-token",
    "services:up": "docker compose up -d --wait postgres redis minio mailpit",
    "services:down": "docker compose down"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "turbo": "2.11.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
