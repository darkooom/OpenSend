{
  "name": "@opensend/worker",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && node --watch --env-file-if-exists=../../.env dist/main.js",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@opensend/config": "workspace:*",
    "@opensend/contracts": "workspace:*",
    "@opensend/core": "workspace:*",
    "@opensend/db": "workspace:*",
    "@opensend/providers": "workspace:*",
    "bullmq": "6.3.15",
    "ioredis": "5.11.1"
  },
  "devDependencies": {
    "vitest": "5.0.5"
  },
  "types": "dist/index.d.ts"
}
