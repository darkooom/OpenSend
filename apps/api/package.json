{
  "name": "@opensend/api",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && node --watch --env-file-if-exists=../../.env dist/main.js",
    "start": "node dist/main.js",
    "cli": "node --env-file-if-exists=../../.env dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@opensend/config": "workspace:*",
    "@opensend/contracts": "workspace:*",
    "@opensend/core": "workspace:*",
    "@opensend/db": "workspace:*",
    "@opensend/providers": "workspace:*",
    "better-auth": "1.7.10",
    "express": "5.2.1",
    "ioredis": "6.0.0",
    "nodemailer": "10.1.2",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "undici": "8.12.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.3",
    "@swc/core": "1.16.18",
    "@types/express": "5.0.6",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5"
  },
  "types": "dist/app.d.ts"
}
