    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@opensend/config": "workspace:*",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "vitest": "5.0.5"
  }
}
