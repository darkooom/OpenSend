    "@opensend/contracts": "workspace:*",
    "@opensend/db": "workspace:*",
    "ipaddr.js": "2.5.0",
    "mustache": "4.2.0",
    "pino": "10.4.0",
    "undici": "8.12.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/mustache": "4.2.6",
    "vitest": "5.0.5"
