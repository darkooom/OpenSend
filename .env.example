# OpenSend configuration. Copy to .env (or run `pnpm setup:local`, which generates random
# local secrets for you). Never commit .env. Production refuses to start with the
# placeholder values below.

NODE_ENV=development
LOG_LEVEL=info

# --- Data stores (docker-compose.yml host ports) -----------------------------------------
DATABASE_URL=postgres://opensend:opensend@localhost:54329/opensend
REDIS_URL=redis://localhost:56379

# --- HTTP ---------------------------------------------------------------------------------
API_PORT=3001
# Dashboard origin. Session cookies and CSRF origin checks are bound to it.
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:3001
# Set to true only behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false

# --- Secrets (generate with `pnpm --filter @opensend/api cli generate-key`) -------------
BETTER_AUTH_SECRET=change-me-to-at-least-32-random-characters
# Comma separated keyId:base64(32 bytes). Keep old keys listed until data is rotated.
OPENSEND_ENCRYPTION_KEYS=v1:change-me
OPENSEND_ENCRYPTION_ACTIVE_KEY_ID=v1

# --- Object storage (S3 compatible; local MinIO) ------------------------------------------
S3_ENDPOINT=http://localhost:59000
S3_REGION=us-east-1
S3_BUCKET=opensend-attachments
S3_ACCESS_KEY_ID=opensend-local
S3_SECRET_ACCESS_KEY=change-me
S3_FORCE_PATH_STYLE=true

# --- Local development provider (Mailpit). Must be false in production. ------------------
OPENSEND_LOCAL_PROVIDER_ENABLED=true
MAILPIT_SMTP_HOST=127.0.0.1
MAILPIT_SMTP_PORT=51025
MAILPIT_API_URL=http://localhost:58025

# --- Platform sender for account emails (invitations, password reset, verification) -------
# Operator-only SMTP, separate from tenant providers. Leave the host empty to disable account
# emails. "none" (plaintext) is refused in production; local default delivers to Mailpit.
OPENSEND_PLATFORM_SMTP_HOST=127.0.0.1
OPENSEND_PLATFORM_SMTP_PORT=51025
OPENSEND_PLATFORM_SMTP_SECURITY=none
OPENSEND_PLATFORM_SMTP_USERNAME=
OPENSEND_PLATFORM_SMTP_PASSWORD=
OPENSEND_PLATFORM_FROM=OpenSend <no-reply@opensend.localhost>

# --- Network policy -----------------------------------------------------------------------
# Hostnames that may resolve to private addresses (operator only, e.g. an internal relay).
OPENSEND_PRIVATE_NETWORK_ALLOWLIST=
# Allow http:// webhook targets (local development only).
OPENSEND_WEBHOOK_ALLOW_HTTP=false

# --- Limits -------------------------------------------------------------------------------
OPENSEND_MAX_RECIPIENTS=50
OPENSEND_MAX_SUBJECT_LENGTH=998
OPENSEND_MAX_BODY_BYTES=2097152
OPENSEND_MAX_ATTACHMENTS=10
OPENSEND_MAX_ATTACHMENT_BYTES=10485760
OPENSEND_MAX_REQUEST_BYTES=20971520
OPENSEND_MAX_SCHEDULE_DAYS=30
OPENSEND_MAX_BATCH_SIZE=100
OPENSEND_MAX_PENDING_PER_ENVIRONMENT=10000
OPENSEND_DEFAULT_MONTHLY_QUOTA=10000
OPENSEND_RATE_LIMIT_PER_MINUTE=600
OPENSEND_RATE_LIMIT_PER_PROJECT_PER_MINUTE=3000
OPENSEND_SES_WEBHOOK_RATE_LIMIT_PER_MINUTE=120
OPENSEND_WEBHOOK_ACTION_RATE_LIMIT_PER_MINUTE=30

# --- Processing ---------------------------------------------------------------------------
OPENSEND_IDEMPOTENCY_TTL_HOURS=24
OPENSEND_MAX_SEND_ATTEMPTS=5
OPENSEND_SEND_LEASE_SECONDS=120
OPENSEND_PROVIDER_TIMEOUT_MS=30000
OPENSEND_WEBHOOK_TIMEOUT_MS=10000
OPENSEND_MAX_WEBHOOK_ATTEMPTS=8
OPENSEND_INVITATION_TTL_HOURS=72

# --- Optional -----------------------------------------------------------------------------
# Bearer token for GET /metrics (required in production).
OPENSEND_METRICS_TOKEN=
# Extra SNS topic ARNs accepted for SES events (per-connection topics are configured in the dashboard).
OPENSEND_SES_ALLOWED_TOPIC_ARNS=
